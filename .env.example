# Local development defaults
SERVER_PORT=4517
SERVER_HOST=127.0.0.1
LICLICK_PUBLIC_WORKSPACE_URL=http://127.0.0.1:4517
LICLICK_PUBLIC_PATH=
LICLICK_FRONTEND_URL=http://127.0.0.1:5173
LICLICK_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ModelView 局部重绘。请求使用 multipart/form-data，同步等待最终 SeedVR2 PNG。
# 已登记的局域网来源 IP 可不设置 API Key；超时按接口验收要求设为 1900 秒。
LICLICK_MODELVIEW_INPAINT_URL=https://10.3.34.11/api/v1/services/modelview-inpaint
LICLICK_MODELVIEW_INPAINT_CA_PATH=
LICLICK_MODELVIEW_INPAINT_API_KEY=
LICLICK_MODELVIEW_INPAINT_TIMEOUT_MS=1900000

# Remote Adobe Substance 3D Baker scheduler. Keep TLS verification enabled and
# point the CA setting at GPU_CONTROL_LAN_CA.crt when the LAN CA is not already
# installed in the operating-system trust store. When unset, the server also
# checks workspace/config, config, secrets, the repository root, and Downloads.
LICLICK_SUBSTANCE_BAKER_BASE_URL=https://10.3.34.11
LICLICK_SUBSTANCE_BAKER_CA_PATH=
LICLICK_SUBSTANCE_BAKER_API_KEY=
LICLICK_SUBSTANCE_BAKER_TEXTURE_CACHE_MB=32768

# Asset V4 production service for automatic UV and retopology.
# The browser always talks to the local Li3D server so this credential is never exposed to web code.
ASSET_SERVICE_BASE_URL=https://10.3.34.11
# Optional when the Asset service has bound this workstation by client IP.
ASSET_SERVICE_API_KEY=
# Preferred for the company/private CA. Leave empty when the CA is already trusted by Windows/Node.
ASSET_SERVICE_CA_CERT_PATH=
# Keep certificate verification enabled in production.
ASSET_SERVICE_TLS_REJECT_UNAUTHORIZED=true
ASSET_SERVICE_REQUEST_TIMEOUT_MS=120000
ASSET_SERVICE_MAX_UPLOAD_BYTES=2147483648
# Maximum size of one downloaded artifact after verification (default: 1 GiB).
ASSET_SERVICE_MAX_ARTIFACT_BYTES=1073741824

# Local Blender used to prepare one imported high-poly model as a V4 retopology project.
# Internal worker object roles are generated automatically; users do not provide extra low-poly models.
# Leave empty to auto-detect Blender. Blender 5.1.x is preferred because it matches the worker.
BLENDER_EXECUTABLE_PATH=
# Stop a local preparation job after 10 minutes.
RETOPOLOGY_PREPARE_TIMEOUT_MS=600000
# Limits for each source model and the complete multipart request.
RETOPOLOGY_PREPARE_MAX_FILE_BYTES=1073741824
RETOPOLOGY_PREPARE_MAX_UPLOAD_BYTES=2147483648
AUTH_MODE=feishu-oauth
SESSION_COOKIE_NAME=liclick_3d_session
SESSION_SECRET=change-me-in-real-env
SESSION_MAX_AGE_DAYS=14
SESSION_COOKIE_SECURE=false

# Preferred login mode: local Atlas gateway + Liclick HttpOnly cookie session.
# Atlas owns the company IDaaS / Feishu authorization flow and writes its local token cache.
LICLICK_ENABLE_ATLAS_LOCAL_LOGIN=true
ATLAS_LOGIN_MODE=interactive
ATLAS_SKILLHUB_PATH=

# Optional IDaaS SP mode. Enable only when IDaaS has registered the Liclick Service URL.
IDAAS_JWT_SSO_ENABLED=false
IDAAS_JWT_SSO_URL=https://idaas.lilith.com/enduser/sp/sso/lilithplugin_jwt57
IDAAS_ENTERPRISE_ID=lilith
# Must be an IDaaS-registered Service URL. 127.0.0.1 will be rejected by IDaaS unless explicitly registered.
IDAAS_SP_SERVICE_URL=

# Optional direct OAuth mode for tests or a non-IDaaS provider.
FEISHU_OAUTH_CLIENT_ID=
FEISHU_OAUTH_CLIENT_SECRET=
FEISHU_OAUTH_AUTHORIZE_URL=
FEISHU_OAUTH_TOKEN_URL=
FEISHU_OAUTH_USERINFO_URL=
FEISHU_OAUTH_REDIRECT_URL=http://127.0.0.1:4517/api/auth/feishu/callback
FEISHU_OAUTH_SCOPE=openid profile email
FEISHU_OAUTH_TOKEN_AUTH_METHOD=client_secret_post
FEISHU_OAUTH_EXTRA_AUTHORIZE_PARAMS=
# Only set true for scripts/smoke-auth-oauth.mjs or an explicitly local mock provider.
FEISHU_OAUTH_ALLOW_LOOPBACK_PROVIDER=false
# Hosted Li3D texture route checks this loopback agent before enabling local painting.
# Production should publish the runtime installer through the cloud API route below.
VITE_LI3D_LOCAL_RUNTIME_API=http://127.0.0.1:4617
VITE_LI3D_LOCAL_RUNTIME_DOWNLOAD_URL=/api/runtime/download/windows-x64
VITE_LI3D_LOCAL_RUNTIME_MIN_VERSION=0.6.0
