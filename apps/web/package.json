  "devDependencies": {
    "@types/node": "^24.0.3",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.171.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.21",
