{
  "name": "@liclick/server",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "serve": "node dist/index.js",
    "serve:local-component": "node dist/localComponent.js",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "test:bake-artifact-plan": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/test-bake-artifact-plan.mjs",
    "test:pipeline-persistence": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/test-project-pipeline-persistence.mjs",
    "test:telemetry": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/test-telemetry-aggregation.mjs",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:push": "node scripts/prisma.mjs db push",
    "db:studio": "node scripts/prisma.mjs studio",
    "db:seed": "node dist/db/seed.js"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "pinyin-pro": "3.28.2",
    "sharp": "^0.34.5",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@prisma/client": "^6.10.1",
    "@types/busboy": "^1.5.4",
    "@types/node": "^24.0.3",
    "@types/ws": "^8.18.1",
    "prisma": "^6.10.1"
  }
}
