{
  "name": "@liclick/server",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "predev": "corepack pnpm --filter @liclick/contracts build",
    "dev": "node scripts/dev-server.mjs",
    "serve": "node dist/index.js",
    "prebuild": "corepack pnpm --filter @liclick/contracts build",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "test:bake-artifact-plan": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/test-bake-artifact-plan.mjs",
    "test:pipeline-persistence": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/test-project-pipeline-persistence.mjs",
    "test:postgres-project-repository": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/test-postgres-project-repository.mjs",
    "test:postgres-project-soak": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/test-postgres-project-soak.mjs",
    "test:postgres-control-plane": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/test-postgres-control-plane.mjs",
    "test:performance-lab-persistence": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/test-performance-lab-persistence.mjs",
    "test:asset-transfer": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/test-asset-transfer.mjs",
    "test:telemetry": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/test-telemetry-aggregation.mjs",
    "test:prompt-polish": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/test-prompt-polish.mjs",
    "test:liclick-personal-account": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/test-liclick-personal-account-boundary.mjs",
    "test:task-history": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node ../../scripts/smoke-task-history.mjs",
    "test:regression": "corepack pnpm --filter @liclick/contracts build && node scripts/run-regression-suite.mjs",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:cloud:migrate": "node scripts/migrate-cloud-projects.mjs",
    "db:push": "node scripts/prisma.mjs db push",
    "db:studio": "node scripts/prisma.mjs studio",
    "db:seed": "node dist/db/seed.js"
  },
  "dependencies": {
    "@liclick/contracts": "workspace:*",
    "busboy": "^1.6.0",
    "pg": "^8.16.3",
    "pinyin-pro": "3.28.2",
    "sharp": "^0.34.5",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@prisma/client": "^6.10.1",
    "@electric-sql/pglite": "^0.3.14",
    "@types/busboy": "^1.5.4",
    "@types/node": "^24.0.3",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.1",
    "prisma": "^6.10.1"
  }
}
