SERVER_PORT=4517
SERVER_HOST=127.0.0.1
DATABASE_URL=file:../../workspace/liclick.db
LICLICK_WORKSPACE_DIR=../../workspace
LICLICK_PUBLIC_WORKSPACE_URL=http://127.0.0.1:4517
LICLICK_FRONTEND_URL=http://127.0.0.1:5173
LICLICK_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
LICLICK_SERVE_WEB=false
LICLICK_WEB_DIST_DIR=../web/dist

# ComfyUI workflow used by the dual-image material repaint module.
COMFYUI_MATERIAL_REPAINT_BASE_URL=http://10.3.2.59:49230

# Remote Adobe Substance 3D Baker scheduler.
LICLICK_SUBSTANCE_BAKER_BASE_URL=https://10.3.34.11
LICLICK_SUBSTANCE_BAKER_CA_PATH=
LICLICK_SUBSTANCE_BAKER_API_KEY=
LICLICK_SUBSTANCE_BAKER_TEXTURE_CACHE_MB=32768

# Asset service (automatic UV and retopology V6).
ASSET_SERVICE_BASE_URL=https://10.3.34.11
# V6 token is injected by secure configuration and sent as Authorization: Bearer.
# Optional only when this workstation is authorized by client IP.
ASSET_SERVICE_API_TOKEN=
# Prefer the internal CA file, or leave empty when the CA is already trusted by Node.
ASSET_SERVICE_CA_CERT_PATH=
ASSET_SERVICE_TLS_REJECT_UNAUTHORIZED=true
ASSET_SERVICE_REQUEST_TIMEOUT_MS=120000
ASSET_SERVICE_MAX_UPLOAD_BYTES=2147483648
# Maximum size of one downloaded artifact after verification (default: 1 GiB).
ASSET_SERVICE_MAX_ARTIFACT_BYTES=1073741824

# Local Blender is retained for legacy maintenance tools only. V6 uploads the
# original high-poly project directly and does not assemble a bootstrap low model.
# Leave empty to auto-detect Blender. Blender 5.1.x is preferred because it matches the worker.
BLENDER_EXECUTABLE_PATH=
RETOPOLOGY_PREPARE_TIMEOUT_MS=600000
RETOPOLOGY_PREPARE_MAX_FILE_BYTES=1073741824
RETOPOLOGY_PREPARE_MAX_UPLOAD_BYTES=2147483648

AUTH_MODE=feishu-oauth
SESSION_COOKIE_NAME=liclick_3d_session
SESSION_SECRET=dev-only-change-me
SESSION_MAX_AGE_DAYS=14
SESSION_COOKIE_SECURE=false

# Direct Feishu Web OAuth. Register this exact callback in the Feishu developer console.
LICLICK_ENABLE_ATLAS_LOCAL_LOGIN=false
# Set only for the per-user local component. A shared web server must not use
# one employee's Atlas/Liclick token as a service credential.
ATLAS_TOKEN_FILE=
FEISHU_OAUTH_CLIENT_ID=
FEISHU_OAUTH_CLIENT_SECRET=
FEISHU_OAUTH_AUTHORIZE_URL=https://accounts.feishu.cn/open-apis/authen/v1/authorize
FEISHU_OAUTH_TOKEN_URL=https://open.feishu.cn/open-apis/authen/v2/oauth/token
FEISHU_OAUTH_USERINFO_URL=https://open.feishu.cn/open-apis/authen/v1/user_info
FEISHU_OAUTH_REDIRECT_URL=http://127.0.0.1:4517/api/auth/feishu/callback
FEISHU_OAUTH_SCOPE=
FEISHU_OAUTH_TOKEN_AUTH_METHOD=client_secret_post
FEISHU_OAUTH_TOKEN_REQUEST_FORMAT=json
# Temporary LAN-only exception; never enable for an Internet-facing deployment.
FEISHU_OAUTH_ALLOW_INSECURE_HTTP_CALLBACK=false

# Optional server-side identity enrichment and telemetry integration.
# Leave disabled until the identity/event/Bitable backend is enabled. Never
# expose these values through VITE_* variables or client-side code.
FEISHU_DIRECTORY_ENRICHMENT_ENABLED=false
FEISHU_TENANT_TOKEN_URL=https://open.feishu.cn/open-apis/auth/v3/tenant_access_token/internal
FEISHU_CONTACT_BASE_URL=https://open.feishu.cn/open-apis/contact/v3
FEISHU_BITABLE_SYNC_ENABLED=false
FEISHU_BITABLE_BASE_URL=https://open.feishu.cn/open-apis/bitable/v1
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=
FEISHU_BITABLE_SYNC_INTERVAL_MS=30000

LICLICK_API_BASE_URL=
LICLICK_API_TIMEOUT_MS=120000
