<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="9.0"
  ExtensionBundleId="com.liclick.live-texture"
  ExtensionBundleVersion="1.1.0"
  ExtensionBundleName="LIclick Live Texture">
  <ExtensionList>
    <Extension Id="com.liclick.live-texture.panel" Version="1.1.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PHXS" Version="[22.0,99.9]" />
      <Host Name="PHSP" Version="[22.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.liclick.live-texture.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/bridge.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--high-dpi-support=1</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
          <StartOn>
            <Event>applicationActivate</Event>
          </StartOn>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>LIclick Live Texture</Menu>
          <Geometry>
            <Size><Width>320</Width><Height>420</Height></Size>
            <MinSize><Width>260</Width><Height>220</Height></MinSize>
            <MaxSize><Width>1200</Width><Height>1600</Height></MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
