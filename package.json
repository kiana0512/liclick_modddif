{
  "name": "liclick-3d-texture",
  "private": true,
  "version": "0.1.13",
  "type": "module",
  "description": "Liclick 3D Texture - Web AI 3D texture studio foundation.",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "verify:prepush": "node scripts/verify-prepush.mjs",
    "dev": "corepack pnpm run dev:raw",
    "dev:raw": "corepack pnpm --parallel --filter @liclick/server --filter @liclick/web dev",
    "dev:web": "corepack pnpm --filter @liclick/web dev",
    "dev:server": "corepack pnpm --filter @liclick/server dev",
    "dev:4517": "node scripts/launch.mjs",
    "build:4517": "corepack pnpm --filter @liclick/server build && corepack pnpm --filter @liclick/web build",
    "start:4517": "node scripts/launch.mjs --SkipBuild",
    "configure:dev:feishu": "powershell -ExecutionPolicy Bypass -File scripts/configure-windows-dev-feishu.ps1",
    "serve:server": "corepack pnpm --filter @liclick/server serve",
    "workspace:up": "powershell -ExecutionPolicy Bypass -File scripts/start-workspace-server.ps1",
    "lan:web:run": "powershell -ExecutionPolicy Bypass -File scripts/run-windows-lan-web.ps1",
    "lan:web:register": "powershell -ExecutionPolicy Bypass -File scripts/register-windows-lan-web.ps1",
    "lan:web:status": "powershell -ExecutionPolicy Bypass -File scripts/status-windows-lan-web.ps1",
    "lan:web:http-oauth": "powershell -ExecutionPolicy Bypass -File scripts/set-windows-lan-http-oauth.ps1",
    "perf:audit": "node scripts/perf-audit.mjs",
    "perf:stress": "node scripts/perf-audit.mjs --stress",
    "workflow:run": "node scripts/li3d-workflow.mjs",
    "test:workflow": "node scripts/test-li3d-workflow.mjs",
    "db:generate": "corepack pnpm --filter @liclick/server db:generate",
    "db:push": "corepack pnpm --filter @liclick/server db:push",
    "db:studio": "corepack pnpm --filter @liclick/server db:studio",
    "db:seed": "corepack pnpm --filter @liclick/server db:seed",
    "load:a100": "node scripts/load-test-a100.mjs",
    "smoke:auth": "corepack pnpm --filter @liclick/server build && node scripts/smoke-auth-oauth.mjs",
    "smoke:lan-http-oauth": "corepack pnpm --filter @liclick/server build && node scripts/smoke-lan-http-oauth.mjs",
    "smoke:identity": "corepack pnpm --filter @liclick/server build && node scripts/smoke-identity-telemetry.mjs",
    "smoke:feishu-platform": "corepack pnpm --filter @liclick/server build && node scripts/smoke-feishu-platform.mjs",
    "smoke:local": "corepack pnpm --filter @liclick/server build && node scripts/smoke-local-server.mjs",
    "smoke:asset-status-retry": "node scripts/smoke-asset-status-retry.mjs",
    "smoke:editor-project-refresh": "node scripts/smoke-editor-project-refresh.mjs",
    "smoke:bake-high-snapshot": "node scripts/smoke-bake-high-snapshot.mjs",
    "smoke:model-filenames": "node scripts/smoke-model-filenames.mjs",
    "smoke:retopology-filenames": "corepack pnpm --filter @liclick/server build && node scripts/smoke-retopology-filenames.mjs",
    "smoke:web": "corepack pnpm --filter @liclick/server build && corepack pnpm --filter @liclick/web build && node scripts/smoke-integrated-web.mjs",
    "simulate:cloud-deployment": "node scripts/simulate-cloud-deployment.mjs",
    "preview:real-auth": "powershell -ExecutionPolicy Bypass -File scripts/run-real-employee-auth-preview.ps1",
    "preview:real-local": "powershell -ExecutionPolicy Bypass -File scripts/run-real-local-preview.ps1",
    "preview:real-auth:simulated-asset": "powershell -ExecutionPolicy Bypass -File scripts/run-real-employee-auth-preview.ps1 -UseAssetServiceSimulator",
    "smoke:remote-bake": "corepack pnpm --filter @liclick/server build && node scripts/smoke-remote-substance-bake.mjs",
    "recover:remote-bake": "corepack pnpm --filter @liclick/server build && node scripts/recover-remote-substance-bakes.mjs",
    "smoke:modelview-inpaint": "corepack pnpm --filter @liclick/server build && node scripts/smoke-modelview-inpaint.mjs",
    "smoke:photoshop": "corepack pnpm --filter @liclick/server build && node scripts/smoke-photoshop-bridge.mjs",
    "package:photoshop": "powershell -ExecutionPolicy Bypass -File scripts/package-photoshop-uxp.ps1",
    "build": "corepack pnpm -r build",
    "build:release": "node scripts/build-release.mjs",
    "lint": "corepack pnpm -r lint",
    "typecheck": "corepack pnpm --filter @liclick/contracts build && corepack pnpm -r typecheck",
    "test:contracts": "corepack pnpm --filter @liclick/contracts test",
    "check:cloud-boundary": "node scripts/check-cloud-boundary.mjs",
    "check:project-repository-boundary": "node scripts/check-project-repository-boundary.mjs",
    "check:cloud-artifact": "node scripts/check-cloud-artifact.mjs",
    "check:web-bundle-budget": "node scripts/check-web-bundle-budget.mjs",
    "check:cloud-release-readiness": "node scripts/check-cloud-release-readiness.mjs",
    "validate:release-env": "node scripts/validate-release-env.mjs",
    "verify:modernization": "corepack pnpm run check:cloud-boundary && corepack pnpm run check:project-repository-boundary && corepack pnpm --filter @liclick/web test:cloud-base-path-assets && corepack pnpm run test:contracts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@typescript-eslint/eslint-plugin": "^8.34.1",
    "@typescript-eslint/parser": "^8.34.1",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1",
    "js-yaml": "4.2.0"
  },
  "pnpm": {
    "overrides": {
      "baseline-browser-mapping@<2.11.0": "2.11.22",
      "browserslist@<=4.28.6": "4.28.9",
      "fflate@>=0.6.0 <0.6.11": "0.6.11",
      "nanoid@<3.3.18": "3.3.19",
      "postcss@<8.5.23": "8.5.28"
    }
  }
}
