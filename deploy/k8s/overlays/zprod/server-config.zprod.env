# Overrides merged onto the base li3d-server-config ConfigMap
# (configMapGenerator behavior: merge). Kept here (duplicating base's
# current values) so a future TLS-less overlay can diverge without
# touching the shared base — see certificate.yaml + ingress-patch.yaml in
# this overlay for the TLS side of this.

LICLICK_PUBLIC_WORKSPACE_URL=https://li3d.lilithgames.com
LICLICK_FRONTEND_URL=https://li3d.lilithgames.com
LICLICK_ALLOWED_ORIGINS=https://li3d.lilithgames.com
FEISHU_OAUTH_REDIRECT_URL=https://li3d.lilithgames.com/api/auth/feishu/callback

# Daily login and usage aggregates, separated from A100.
LICLICK_TELEMETRY_SOURCE=正式站
FEISHU_BITABLE_SYNC_ENABLED=true
FEISHU_BITABLE_APP_TOKEN=U1IhbUlrlaFRFJsHB4rcJKgAnsd
FEISHU_BITABLE_TABLE_ID=tblFHaZQY9UBDEop
FEISHU_BITABLE_SYNC_INTERVAL_MS=30000
