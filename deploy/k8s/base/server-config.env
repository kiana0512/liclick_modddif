# Non-secret backend config, loaded via configMapGenerator.
# Overridable per-environment from an overlay (see k8s/overlays/prod).

SERVER_PORT=4517
SERVER_HOST=0.0.0.0
LICLICK_WORKSPACE_DIR=/data/workspace
LICLICK_RUNTIME_MODE=cloud
LICLICK_PROJECT_REPOSITORY=postgres

# nginx owns the browser bundle; the server handles Cloud APIs.
LICLICK_SERVE_WEB=false

# Public URL the app is reachable at. Update this per environment — it is
# used for CORS allow-list, cookie origin, and the OAuth redirect default.
LICLICK_PUBLIC_WORKSPACE_URL=https://li3d.lilithgames.com
LICLICK_PUBLIC_PATH=
LICLICK_FRONTEND_URL=https://li3d.lilithgames.com
LICLICK_ALLOWED_ORIGINS=https://li3d.lilithgames.com

# feishu-oauth (recommended for a real deployment) or dev-mock (no login,
# useful only to smoke-test the deployment itself).
AUTH_MODE=feishu-oauth
SESSION_COOKIE_NAME=liclick_3d_session
SESSION_MAX_AGE_DAYS=14
SESSION_COOKIE_SECURE=true

# Atlas runs in the server image with per-user homes on the retained PVC.
LICLICK_ENABLE_ATLAS_LOCAL_LOGIN=false
LICLICK_SHARED_TEST_ACCOUNT_ENABLED=false

IDAAS_JWT_SSO_ENABLED=false
IDAAS_JWT_SSO_URL=https://idaas.lilith.com/enduser/sp/sso/lilithplugin_jwt62
IDAAS_ENTERPRISE_ID=lilith
IDAAS_SP_SERVICE_URL=

FEISHU_OAUTH_AUTHORIZE_URL=https://accounts.feishu.cn/open-apis/authen/v1/authorize
FEISHU_OAUTH_TOKEN_URL=https://open.feishu.cn/open-apis/authen/v2/oauth/token
FEISHU_OAUTH_USERINFO_URL=https://open.feishu.cn/open-apis/authen/v1/user_info
FEISHU_OAUTH_REDIRECT_URL=https://li3d.lilithgames.com/api/auth/feishu/callback
FEISHU_OAUTH_SCOPE=
FEISHU_OAUTH_TOKEN_AUTH_METHOD=client_secret_post
FEISHU_OAUTH_TOKEN_REQUEST_FORMAT=json
FEISHU_OAUTH_ALLOW_INSECURE_HTTP_CALLBACK=false

# Formal local repaint business API
LICLICK_MODELVIEW_INPAINT_URL=https://10.3.34.11/api/v1/services/modelview-inpaint
LICLICK_MODELVIEW_INPAINT_TIMEOUT_MS=1900000

# Substance texture baking
LICLICK_SUBSTANCE_BAKER_BASE_URL=https://10.3.34.11
LICLICK_SUBSTANCE_BAKER_TEXTURE_CACHE_MB=32768

# Asset service: UV and asset processing
ASSET_SERVICE_BASE_URL=https://10.3.34.11
ASSET_SERVICE_TLS_REJECT_UNAUTHORIZED=true
ASSET_SERVICE_REQUEST_TIMEOUT_MS=120000
ASSET_SERVICE_MAX_UPLOAD_BYTES=2147483648
ASSET_SERVICE_MAX_ARTIFACT_BYTES=1073741824

# Object storage: LICLICK_OBJECT_STORAGE_ENDPOINT/BUCKET/ACCESS_KEY_ID/
# SECRET_ACCESS_KEY live in the Secret, written by
# deploy/prepare-cloud-secret.sh from CI/CD variables — not here.
# The endpoint must be the HTTPS ingress hostname
# (https://li3d-s3.lilithgames.com, see
# deploy/k8s/infra/object-storage-ingress/), never the RGW address
# directly: presigned URLs are handed to the browser, and an https page
# cannot upload to a plain-http URL.
LICLICK_OBJECT_STORAGE_ALLOW_INSECURE_HTTP=false

# Qwen non-secret defaults; the efficiency team injects the API key.
QWEN3_VL_PLUS_API_BASE_URL=https://llm-proxy.lilith.com/v1
QWEN3_VL_PLUS_MODEL=qwen3-vl-plus
QWEN3_VL_PLUS_TIMEOUT_MS=65000
LICLICK_MODELVIEW_SINGLE_VIEW_URL=https://10.3.34.11/api/v1/services/modelview-single-view
