# Copy this file to server.env (gitignored) and fill in real values before
# running `kubectl apply -k`. Never commit the filled-in file.
#
#   cp k8s/base/secrets/server.env.example k8s/base/secrets/server.env

# Required. Generate with: openssl rand -hex 32
# The server refuses to start on a non-loopback host with the default value.
SESSION_SECRET=change-me-to-a-random-64-char-hex-string

# Required only when AUTH_MODE=feishu-oauth (see server-config.env).
FEISHU_OAUTH_CLIENT_ID=
FEISHU_OAUTH_CLIENT_SECRET=
