# TLS terminates at the trusted ingress. Preserve its forwarded scheme.
map $http_x_forwarded_proto $li3d_forwarded_proto {
    default $scheme;
    https https;
}
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 256m;
    location = /healthz {
        default_type text/plain;
        return 200 "ok\n";
    }
    location ^~ /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $li3d_forwarded_proto;
        # Synchronous ModelView can wait up to 2600 seconds.
        proxy_read_timeout 2700s;
        proxy_send_timeout 2700s;
        proxy_buffering off;
    }
    location ^~ /workspace/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $li3d_forwarded_proto;
        proxy_read_timeout 600s;
    }
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}
